# hu-knowledge-ark konfiguráció
# Másold át .env-be és állítsd be a saját környezetedre:
#   cp .env.example .env

# Hova mentse az ark a tartalmat (ZIM-ek, térkép, library.xml).
# Tipp: lokális SSD-re tedd, hogy gyors legyen és ne függj a NAS-tól.
DATA_DIR=/opt/hu-knowledge-ark/data

# A konténerek milyen userrel írjanak a DATA_DIR-be.
# Linuxon `id` paranccsal nézheted meg a saját UID/GID-edet.
# NAS-on (Synology/TrueNAS) gyakran 1000:1000 vagy a megosztás tulajdonosa.
PUID=1000
PGID=1000

# Melyik porton legyen elérhető a két szolgáltatás a hoston.
# Akkor változtass, ha ezek a portok már foglaltak nálad.
KIWIX_PORT=8888
LANDING_PORT=5050

# Időzóna (logok és frissítési idő szempontjából fontos)
TZ=Europe/Budapest

# A host gép `docker` csoportjának GID-je. A Beállítások UI-ban a "Letöltés most"
# gomb a Docker socket-en át hív parancsokat, ehhez kell a csoporttagság.
# Nézd meg: `getent group docker | cut -d: -f3`  (vagy `stat -c %g /var/run/docker.sock`)
DOCKER_GID=989

# Flask session aláíró kulcs. Tetszőleges hosszú véletlen string,
# pl: `openssl rand -hex 32`
FLASK_SECRET=replace-with-random-string
